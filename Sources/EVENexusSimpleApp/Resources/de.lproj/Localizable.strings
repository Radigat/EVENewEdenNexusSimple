"%@, %@ planned units, valued at the current lowest Jita IV-4 sell-order price. Gross revenue: %@." = "%1$@, %2$@ geplante Einheiten, bewertet zum aktuell niedrigsten Verkaufspreis in Jita IV-4. Bruttoerlös: %3$@.";
